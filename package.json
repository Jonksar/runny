{
  "name": "runny",
  "version": "0.1.0",
  "description": "Vibe code while running. Puts your phone's microphone in front of the Codex realtime voice agent.",
  "type": "module",
  "bin": { "runny": "dist/cli.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": { "node": ">=22" },
  "files": ["dist", "web", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js serve"
  },
  "keywords": ["codex", "voice", "realtime", "coding-agent", "webrtc", "running"],
  "author": "Joonatan Samuel",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Jonksar/runny.git" },
  "homepage": "https://github.com/Jonksar/runny#readme",
  "bugs": { "url": "https://github.com/Jonksar/runny/issues" },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
